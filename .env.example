# Upstash Redis. En Vercel se cargan solas al conectar Storage → Upstash.
# Sin esto, en tu compu se guarda en .data/db.json
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Código que tus amigos necesitan para crear su cuenta (la primera cuenta, la tuya, no lo pide).
INVITE_CODE=

# Notificaciones push. Generá las claves con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-mail@ejemplo.com

# Secreto para el chequeo automático: /api/check?secret=...
CRON_SECRET=
