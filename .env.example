# Contraseña para entrar a la app (usuario: cualquiera). Si la dejás vacía, la app queda abierta.
APP_PASSWORD=

# Upstash Redis (gratis en upstash.com). Sin esto, en local se guarda en .data/db.json
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bot de Telegram (ver README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Secreto para el chequeo automático: /api/check?secret=...
CRON_SECRET=
